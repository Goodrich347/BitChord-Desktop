+import { isSectionHeader, type LyricLine, type LyricWord } from './model';
+
+/**
+ * On-demand lyric translation: a port of LyricsTranslation.kt.
+ *
+ * Google's lightweight web endpoint answers a whole batch of lines at once, so
+ * a song costs one or two requests rather than one per line. Nothing is
+ * installed and no key is needed; the endpoint sends
+ * `access-control-allow-origin: *`, so the page itself can call it.
+ *
+ * - Blank (instrumental) lines are never sent and stay in place.
+ * - Section labels and background vocals are separate slots, translated on
+ *   their own so a `[Chorus]` is not glued to the line under it.
+ * - Slots are batched up to 3,500 characters with a private-use marker between
+ *   them (`\uE0000001\uE001`), which is how the answer is mapped back to lines
+ *   exactly: the response is split on the markers, and a count mismatch throws
+ *   the whole answer away.
+ * - At most two requests run at a time; each has a 12 s deadline and is
+ *   cancelled when the track, the lyrics or the destination language changes.
+ * - Timings survive: translated lines are rebuilt from the originals, so
+ *   timeMs, sungUntilMs, background placement and list position are untouched.
+ */
+
+export const ENDPOINT = 'https://translate.googleapis.com/translate_a/single';
+export const MAX_BATCH_CHARS = 3_500;
+export const MAX_PARALLEL_REQUESTS = 2;
+export const REQUEST_TIMEOUT_MS = 12_000;
+/** Bumped when the cached shape or the batching changes, so old answers are ignored. */
+export const CACHE_VERSION = 1;
+const MEMORY_ENTRIES = 12;
+const MAX_CACHE_BYTES = 2 * 1024 * 1024;
+const STORE_KEY = 'bitchord:lyrics-translation';
+
+// ---- Languages --------------------------------------------------------------------------
+
+export interface Language {
+  code: string;
+  label: string;
+}
+
+/** The destination languages the picker offers, alphabetical by name. */
+export const LANGUAGES: Language[] = [
+  { code: 'ar', label: 'Arabic' },
+  { code: 'bn', label: 'Bengali' },
+  { code: 'zh', label: 'Chinese (Simplified)' },
+  { code: 'cs', label: 'Czech' },
+  { code: 'da', label: 'Danish' },
+  { code: 'nl', label: 'Dutch' },
+  { code: 'en', label: 'English' },
+  { code: 'fa', label: 'Persian' },
+  { code: 'fil', label: 'Filipino' },
+  { code: 'fi', label: 'Finnish' },
+  { code: 'fr', label: 'French' },
+  { code: 'de', label: 'German' },
+  { code: 'el', label: 'Greek' },
+  { code: 'he', label: 'Hebrew' },
+  { code: 'hi', label: 'Hindi' },
+  { code: 'hu', label: 'Hungarian' },
+  { code: 'id', label: 'Indonesian' },
+  { code: 'it', label: 'Italian' },
+  { code: 'ja', label: 'Japanese' },
+  { code: 'ko', label: 'Korean' },
+  { code: 'ms', label: 'Malay' },
+  { code: 'no', label: 'Norwegian' },
+  { code: 'pl', label: 'Polish' },
+  { code: 'pt', label: 'Portuguese' },
+  { code: 'ro', label: 'Romanian' },
+  { code: 'ru', label: 'Russian' },
+  { code: 'es', label: 'Spanish' },
+  { code: 'sv', label: 'Swedish' },
+  { code: 'th', label: 'Thai' },
+  { code: 'tr', label: 'Turkish' },
+  { code: 'uk', label: 'Ukrainian' },
+  { code: 'ur', label: 'Urdu' },
+  { code: 'vi', label: 'Vietnamese' },
+];
+
+/** Scripts written right to left, so the panel can mirror the layout. */
+const RTL_LANGUAGES = new Set(['ar', 'arc', 'ckb', 'dv', 'fa', 'he', 'iw', 'ji', 'ps', 'sd', 'ug', 'ur', 'yi']);
+
+/**
+ * A language tag's base subtag, with the legacy aliases Android and the web
+ * still hand out (iw→he, in→id, ji→yi). Comparison only: a destination such as
+ * `zh-CN` is sent as given, because narrowing it to `zh` would hand back
+ * Simplified when Traditional was asked for.
+ */
+export function normalizeLanguage(tag: string): string {
+  const base = (tag.replace(/_/g, '-').split('-')[0] ?? '').toLowerCase();
+  if (base === 'iw') return 'he';
+  if (base === 'in') return 'id';
+  if (base === 'ji') return 'yi';
+  return base;
+}
+
+export function sameLanguage(first: string, second: string): boolean {
+  return normalizeLanguage(first) === normalizeLanguage(second) && normalizeLanguage(first) !== '';
+}
+
+export function isRtl(tag: string): boolean {
+  return RTL_LANGUAGES.has(normalizeLanguage(tag));
+}
+
+export function languageLabel(tag: string): string {
+  const base = normalizeLanguage(tag);
+  return LANGUAGES.find((l) => l.code === base)?.label ?? (base ? base.toUpperCase() : 'English');
+}
+
+/** The app has no locale picker of its own, so the destination starts at the browser's language. */
+export function defaultTargetLanguage(): string {
+  const tag = typeof navigator === 'undefined' ? '' : navigator.language;
+  return normalizeLanguage(tag || 'en') || 'en';
+}
+
+// ---- Batching ---------------------------------------------------------------------------
+
+/** One piece of text to translate: a line's lead, or its background vocal. */
+export interface TextSlot {
+  lineIndex: number;
+  background: boolean;
+  text: string;
+  sectionHeader: boolean;
+}
+
+export interface Batch {
+  slots: TextSlot[];
+  payload: string;
+}
+
+/**
+ * The lines as text slots, in order, skipping blanks. A `[Chorus]` loses its
+ * brackets in the request (so it reads as words, not code) and gets them back
+ * when the answer is rebuilt.
+ */
+export function flattenLines(lines: LyricLine[]): TextSlot[] {
+  const slots: TextSlot[] = [];
+  lines.forEach((line, lineIndex) => {
+    if (line.text.trim()) {
+      const header = isSectionHeader(line.text);
+      slots.push({
+        lineIndex,
+        background: false,
+        text: header ? line.text.replace(/^\[/, '').replace(/\]$/, '').trim() : line.text,
+        sectionHeader: header,
+      });
+    }
+    const backing = line.background;
+    if (backing && backing.text.trim()) {
+      slots.push({ lineIndex, background: true, text: backing.text, sectionHeader: false });
+    }
+  });
+  return slots;
+}
+
+/** The marker between two slots: 6 characters, so a separator costs 8 (`\n` + marker + `\n`). */
+export function marker(index: number): string {
+  return `\uE000${String(index).padStart(4, '0')}\uE001`;
+}
+
+const SEPARATOR_CHARS = 8;
+
+export function payloadOf(slots: TextSlot[]): string {
+  return slots.map((slot, index) => (index > 0 ? `\n${marker(index)}\n${slot.text}` : slot.text)).join('');
+}
+
+/** Splits an answer on the markers; the parts line up with the batch's slots. */
+export function splitByMarkers(body: string): string[] {
+  return body.split(/\uE000[^\uE001]*\uE001/).map((part) => part.trim());
+}
+
+/** Groups slots into payloads no longer than [MAX_BATCH_CHARS], never splitting a slot. */
+export function batchesOf(slots: TextSlot[]): Batch[] {
+  const batches: Batch[] = [];
+  let current: TextSlot[] = [];
+  let length = 0;
+  const flush = () => {
+    if (!current.length) return;
+    batches.push({ slots: current, payload: payloadOf(current) });
+    current = [];
+    length = 0;
+  };
+  for (const slot of slots) {
+    const added = slot.text.length + (current.length ? SEPARATOR_CHARS : 0);
+    if (current.length && length + added > MAX_BATCH_CHARS) flush();
+    current.push(slot);
+    length += added;
+  }
+  flush();
+  return batches;
+}
+
+/** The `translate_a/single` answer: segments joined, detected language from `root[2]`. */
+export interface GtxAnswer {
+  texts: string[];
+  source: string;
+}
+
+export function parseGtxResponse(root: unknown, expectedSlots: number): GtxAnswer | null {
+  if (!Array.isArray(root)) return null;
+  const segments = root[0];
+  if (!Array.isArray(segments)) return null;
+  const body = segments
+    .map((segment) => (Array.isArray(segment) && typeof segment[0] === 'string' ? (segment[0] as string) : ''))
+    .join('');
+  const texts = splitByMarkers(body);
+  // A partial or reordered answer would put the wrong words on the wrong
+  // timestamps; the original lines are better than a mis-mapping.
+  if (texts.length !== expectedSlots || texts.some((text) => !text)) return null;
+  const source = typeof root[2] === 'string' ? root[2] : '';
+  return { texts, source };
+}
+
+interface BatchAnswer extends GtxAnswer {
+  sourceWeight: number;
+}
+
+async function requestBatch(
+  batch: Batch,
+  target: string,
+  { signal, fetchImpl }: { signal?: AbortSignal; fetchImpl: typeof fetch },
+): Promise<BatchAnswer | null> {
+  const body = new URLSearchParams({
+    client: 'dict-chrome-ex',
+    sl: 'auto',
+    tl: target,
+    dt: 't',
+    q: batch.payload,
+  });
+  // A form POST with no custom headers is a simple request, so it skips the
+  // CORS preflight the endpoint does not answer.
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
+  const cancel = () => controller.abort();
+  signal?.addEventListener('abort', cancel, { once: true });
+  try {
+    const response = await fetchImpl(ENDPOINT, {
+      method: 'POST',
+      body,
+      headers: { Accept: 'application/json' },
+      signal: controller.signal,
+      referrerPolicy: 'no-referrer',
+    });
+    if (!response.ok) return null;
+    const parsed = parseGtxResponse(await response.json(), batch.slots.length);
+    return parsed ? { ...parsed, sourceWeight: batch.payload.length } : null;
+  } catch {
+    return null;
+  } finally {
+    clearTimeout(timer);
+    signal?.removeEventListener('abort', cancel);
+  }
+}
+
+// ---- Rebuilding -------------------------------------------------------------------------
+
+/**
+ * A word-synced line's source holds, pauses and pace changes, projected onto
+ * the translated text: the translated tokens take their share of the source
+ * character timeline, so the sweep speeds up and holds with the original
+ * vocal instead of running evenly. This is an approximate reading aid, not
+ * word alignment in the target language.
+ */
+export function projectWords(source: LyricLine, translated: string): LyricWord[] {
+  const words = source.words;
+  if (!words.length || !translated) return [];
+  const spans = words.map((word) => ({
+    start: word.startMs,
+    end: Math.max(word.startMs, word.endMs),
+    chars: Math.max(1, word.text.length),
+  }));
+  const total = spans.reduce((sum, span) => sum + span.chars, 0);
+  const timeAt = (position: number): number => {
+    const at = Math.min(Math.max(position, 0), total);
+    let base = 0;
+    for (const span of spans) {
+      if (at <= base + span.chars) return Math.round(span.start + (span.end - span.start) * ((at - base) / span.chars));
+      base += span.chars;
+    }
+    return spans[spans.length - 1]!.end;
+  };
+  const tokens = translated.match(/\S+/g) ?? [translated];
+  const length = Math.max(1, translated.length);
+  const out: LyricWord[] = [];
+  let cursor = 0;
+  for (const token of tokens) {
+    const index = translated.indexOf(token, cursor);
+    const from = index < 0 ? cursor : index;
+    cursor = from + token.length;
+    const previousEnd = out[out.length - 1]?.endMs ?? 0;
+    const startMs = Math.max(timeAt((total * from) / length), previousEnd);
+    const endMs = Math.max(startMs, timeAt((total * cursor) / length));
+    out.push({ startMs, endMs, text: token, syllables: [] });
+  }
+  return out;
+}
+
+/**
+ * The originals with their translated text and the same timings: every line
+ * keeps its position, its end, its answering vocal and its alignment.
+ */
+export function rebuildLines(original: LyricLine[], slots: TextSlot[], texts: string[]): LyricLine[] {
+  const leads = new Map<number, { text: string; section: boolean }>();
+  const backs = new Map<number, string>();
+  slots.forEach((slot, index) => {
+    const text = texts[index] ?? slot.text;
+    if (slot.background) backs.set(slot.lineIndex, text);
+    else leads.set(slot.lineIndex, { text, section: slot.sectionHeader });
+  });
+  return original.map((line, index) => {
+    const lead = leads.get(index);
+    const backing = backs.get(index);
+    const text = lead ? (lead.section ? `[${lead.text}]` : lead.text) : line.text;
+    const background = line.background
+      ? {
+          ...line.background,
+          text: backing ?? line.background.text,
+          words:
+            backing && line.background.words.length
+              ? projectWords(line.background, backing)
+              : line.background.words,
+        }
+      : null;
+    return {
+      ...line,
+      text,
+      words: lead && text !== line.text && line.words.length ? projectWords(line, text) : line.words,
+      background,
+    };
+  });
+}
+
+// ---- Cache ------------------------------------------------------------------------------
+
+interface CachedTranslation {
+  version: number;
+  source: string;
+  target: string;
+  texts: string[];
+  /** When it was last used, for trimming the persisted store. */
+  at: number;
+}
+
+const memory = new Map<string, CachedTranslation>();
+
+function rememberInMemory(key: string, entry: CachedTranslation) {
+  memory.delete(key);
+  memory.set(key, entry);
+  while (memory.size > MEMORY_ENTRIES) memory.delete(memory.keys().next().value!);
+}
+
+let store: Record<string, CachedTranslation> | null = null;
+
+function persisted(): Record<string, CachedTranslation> {
+  if (store) return store;
+  store = {};
+  try {
+    const raw = typeof localStorage === 'undefined' ? null : localStorage.getItem(STORE_KEY);
+    const parsed = raw ? (JSON.parse(raw) as Record<string, CachedTranslation>) : {};
+    if (parsed && typeof parsed === 'object') store = parsed;
+  } catch {
+    store = {};
+  }
+  return store;
+}
+
+function persist() {
+  const entries = persisted();
+  try {
+    let json = JSON.stringify(entries);
+    while (json.length > MAX_CACHE_BYTES) {
+      const oldest = Object.entries(entries).sort((a, b) => (a[1].at ?? 0) - (b[1].at ?? 0))[0];
+      if (!oldest) break;
+      delete entries[oldest[0]];
+      json = JSON.stringify(entries);
+    }
+    localStorage.setItem(STORE_KEY, json);
+  } catch {
+    // A full or unavailable store costs speed, not correctness.
+  }
+}
+
+/** FNV-1a twice over, as a 64-bit hex key: a cache key needs to be cheap, not cryptographic. */
+function hashKey(input: string): string {
+  let first = 0x811c9dc5;
+  let second = 0x9e3779b9;
+  for (let index = 0; index < input.length; index++) {
+    const code = input.charCodeAt(index);
+    first = Math.imul(first ^ code, 0x01000193);
+    second = Math.imul(second ^ code, 0x85ebca6b);
+  }
+  return (first >>> 0).toString(16).padStart(8, '0') + (second >>> 0).toString(16).padStart(8, '0');
+}
+
+/** Hash of track, destination and the source text, so a new provider's lyrics get their own entry. */
+export function cacheKey(videoId: string, target: string, slots: TextSlot[]): string {
+  return hashKey([CACHE_VERSION, videoId, target, ...slots.map((slot) => slot.text)].join('\u0000'));
+}
+
+function readCache(key: string): CachedTranslation | null {
+  const hot = memory.get(key);
+  if (hot && hot.version === CACHE_VERSION) {
+    rememberInMemory(key, hot);
+    return hot;
+  }
+  const cold = persisted()[key];
+  if (!cold || cold.version !== CACHE_VERSION) return null;
+  cold.at = Date.now();
+  rememberInMemory(key, cold);
+  return cold;
+}
+
+function writeCache(key: string, entry: CachedTranslation) {
+  rememberInMemory(key, entry);
+  persisted()[key] = entry;
+  persist();
+}
+
+/** Drops every remembered translation: tests, and a "clear cache" that has to start clean. */
+export function forgetTranslations() {
+  memory.clear();
+  store = {};
+  try {
+    if (typeof localStorage !== 'undefined') localStorage.removeItem(STORE_KEY);
+  } catch {
+    // Nothing to forget.
+  }
+}
+
+// ---- Translation ------------------------------------------------------------------------
+
+export type TranslationResult =
+  | { kind: 'translated'; lines: LyricLine[]; sourceLanguage: string; fromCache: boolean }
+  | { kind: 'same'; language: string }
+  | { kind: 'failed'; reason: 'empty' | 'network' | 'malformed' | 'cancelled' };
+
+export interface TranslateOptions {
+  videoId: string;
+  lines: LyricLine[];
+  target: string;
+  signal?: AbortSignal;
+  fetchImpl?: typeof fetch;
+}
+
+/**
+ * The lines in [target], with their timings. Cancelling is reported as
+ * `cancelled` rather than a failure so the panel can ignore it.
+ */
+export async function translateLyrics({
+  videoId,
+  lines,
+  target: requested,
+  signal,
+  fetchImpl = fetch,
+}: TranslateOptions): Promise<TranslationResult> {
+  const target = requested.trim();
+  if (!target || !lines.length) return { kind: 'failed', reason: 'empty' };
+  const slots = flattenLines(lines);
+  if (!slots.length) return { kind: 'failed', reason: 'empty' };
+
+  const key = cacheKey(videoId, target, slots);
+  const cached = readCache(key);
+  if (cached && cached.texts.length === slots.length) {
+    return sameLanguage(cached.source, target)
+      ? { kind: 'same', language: cached.source }
+      : {
+          kind: 'translated',
+          lines: rebuildLines(lines, slots, cached.texts),
+          sourceLanguage: cached.source,
+          fromCache: true,
+        };
+  }
+
+  const batches = batchesOf(slots);
+  const answers: (BatchAnswer | null)[] = [];
+  for (let index = 0; index < batches.length; index += MAX_PARALLEL_REQUESTS) {
+    const group = batches.slice(index, index + MAX_PARALLEL_REQUESTS);
+    answers.push(...(await Promise.all(group.map((batch) => requestBatch(batch, target, { signal, fetchImpl })))));
+    if (signal?.aborted) return { kind: 'failed', reason: 'cancelled' };
+  }
+  if (answers.some((answer) => answer === null)) return { kind: 'failed', reason: 'network' };
+
+  const complete = answers as BatchAnswer[];
+  const detected = new Map<string, number>();
+  for (const answer of complete) {
+    const language = normalizeLanguage(answer.source);
+    if (!language) continue;
+    detected.set(language, (detected.get(language) ?? 0) + answer.sourceWeight);
+  }
+  let source = '';
+  let weight = 0;
+  for (const [language, value] of detected) {
+    if (value > weight) {
+      source = language;
+      weight = value;
+    }
+  }
+  if (!source) return { kind: 'failed', reason: 'malformed' };
+
+  const texts = complete.flatMap((answer) => answer.texts);
+  if (texts.length !== slots.length) return { kind: 'failed', reason: 'malformed' };
+
+  writeCache(key, { version: CACHE_VERSION, source, target, texts, at: Date.now() });
+  return sameLanguage(source, target)
+    ? { kind: 'same', language: source }
+    : { kind: 'translated', lines: rebuildLines(lines, slots, texts), sourceLanguage: source, fromCache: false };
+}
