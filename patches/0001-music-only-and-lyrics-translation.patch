@@ -0,0 +1,163 @@
+import { describe, expect, it, vi } from 'vitest';
+import type { Cut } from '@/data/music/api';
+import type { Track } from '@/data/music/types';
+import { createVersionResolver, type VersionSources } from './versions';
+
+// Ported from YtMusicRepository's resolveAudio / resolveVideo: what the app
+// asks YouTube for when a track is switched between its two cuts, and what it
+// settles on when YouTube pairs nothing — which is every signed-out response.
+
+const track = (
+  videoId: string,
+  title: string,
+  artist: string,
+  durationSec: number | null = null,
+  album: string | null = null,
+): Track => ({
+  videoId,
+  title,
+  artists: artist ? [{ name: artist, id: null }] : [],
+  album: album ? { name: album, id: null } : null,
+  durationSec,
+  explicit: false,
+  thumbnail: null,
+  index: null,
+  plays: null,
+});
+
+const cut = (t: Track, isVideo: boolean): Cut => ({ track: t, isVideo });
+
+const VIDEO = track('vid1', 'Kesariya - Brahmastra | Official Video', 'Arijit Singh', 271);
+const SONG = track('song1', 'Kesariya', 'Arijit Singh', 268, 'Brahmastra');
+
+function sources(overrides: Partial<VersionSources> = {}): VersionSources {
+  return {
+    findCuts: vi.fn(async () => null),
+    searchSongs: vi.fn(async () => [] as Track[]),
+    searchVideos: vi.fn(async () => [] as Track[]),
+    ...overrides,
+  };
+}
+
+describe('resolveAudio', () => {
+  it('takes YouTube’s pair without searching', async () => {
+    const deps = sources({ findCuts: vi.fn(async () => ({ self: cut(VIDEO, true), other: cut(SONG, false) })) });
+    const { resolveAudio, pairedWith } = createVersionResolver(deps);
+
+    await expect(resolveAudio(VIDEO)).resolves.toEqual(SONG);
+    expect(deps.searchSongs).not.toHaveBeenCalled();
+    // YouTube's own pair, both ways round: the only case a time map exists for.
+    expect(pairedWith(VIDEO.videoId)).toBe(SONG.videoId);
+    expect(pairedWith(SONG.videoId)).toBe(VIDEO.videoId);
+  });
+
+  it('leaves a song alone when its own row is the catalogue cut', async () => {
+    const deps = sources({ findCuts: vi.fn(async () => ({ self: cut(SONG, false), other: cut(VIDEO, true) })) });
+    const { resolveAudio } = createVersionResolver(deps);
+
+    await expect(resolveAudio(SONG)).resolves.toEqual(SONG);
+    expect(deps.searchSongs).not.toHaveBeenCalled();
+  });
+
+  it('searches the title and artist when YouTube pairs nothing, and takes the real recording', async () => {
+    const deps = sources({
+      searchSongs: vi.fn(async () => [
+        track('cover', 'Kesariya', 'Some Cover Band', 268),
+        track('slow', 'Kesariya (Slowed + Reverb)', 'Arijit Singh', 300),
+        SONG,
+      ]),
+    });
+    const { resolveAudio } = createVersionResolver(deps);
+
+    await expect(resolveAudio(VIDEO)).resolves.toEqual(SONG);
+    // The packaging is not put to a search box; the artist and the title are.
+    expect(vi.mocked(deps.searchSongs).mock.calls[0]?.[0]).toBe('kesariya arijit singh');
+  });
+
+  it('walks the queries in order and stops at the first that matches', async () => {
+    const searchSongs = vi
+      .fn<(query: string) => Promise<Track[]>>()
+      .mockResolvedValueOnce([])
+      .mockResolvedValueOnce([SONG]);
+    const deps = sources({ searchSongs, findCuts: vi.fn(async () => { throw new Error('offline'); }) });
+    const { resolveAudio } = createVersionResolver(deps);
+
+    await expect(resolveAudio(VIDEO)).resolves.toEqual(SONG);
+    expect(searchSongs.mock.calls.map(([query]) => query)).toEqual(['kesariya arijit singh', 'kesariya']);
+  });
+
+  it('takes an official song that runs far shorter than the video, once the search has it', async () => {
+    // A video with a spoken intro: over a minute longer than its release, so
+    // the ordinary matcher must refuse it and the switch's own must not.
+    const long = track('vid2', 'Kesariya - Brahmastra | Official Video', 'Arijit Singh', 340);
+    const deps = sources({ searchSongs: vi.fn(async () => [track('song2', 'Kesariya', 'Arijit Singh', 200)]) });
+    const { resolveAudio } = createVersionResolver(deps);
+
+    await expect(resolveAudio(long)).resolves.toMatchObject({ videoId: 'song2' });
+  });
+
+  it('keeps the video when no search answers with the song', async () => {
+    const deps = sources({
+      searchSongs: vi.fn(async () => [track('cover', 'Kesariya', 'Some Cover Band', 268)]),
+    });
+    const { resolveAudio } = createVersionResolver(deps);
+
+    await expect(resolveAudio(VIDEO)).resolves.toEqual(VIDEO);
+    // Answered, so it is remembered: the next play asks nothing.
+    const calls = vi.mocked(deps.searchSongs).mock.calls.length;
+    await expect(resolveAudio(VIDEO)).resolves.toEqual(VIDEO);
+    expect(vi.mocked(deps.searchSongs).mock.calls.length).toBe(calls);
+  });
+
+  it('does not remember a miss that came of a failed search', async () => {
+    const deps = sources({ searchSongs: vi.fn(async () => Promise.reject(new Error('offline'))) });
+    const { resolveAudio } = createVersionResolver(deps);
+
+    await expect(resolveAudio(VIDEO)).resolves.toEqual(VIDEO);
+    const calls = vi.mocked(deps.searchSongs).mock.calls.length;
+    await expect(resolveAudio(VIDEO)).resolves.toEqual(VIDEO);
+    expect(vi.mocked(deps.searchSongs).mock.calls.length).toBeGreaterThan(calls);
+  });
+});
+
+describe('resolveVideo', () => {
+  const audio = track('song1', 'Kesariya', 'Arijit Singh', 268, 'Brahmastra');
+
+  it('takes YouTube’s pair without searching', async () => {
+    const deps = sources({ findCuts: vi.fn(async () => ({ self: cut(audio, false), other: cut(VIDEO, true) })) });
+    const { resolveVideo } = createVersionResolver(deps);
+
+    await expect(resolveVideo(audio)).resolves.toEqual(VIDEO);
+    expect(deps.searchVideos).not.toHaveBeenCalled();
+  });
+
+  it('searches videos when YouTube pairs nothing', async () => {
+    const deps = sources({ searchVideos: vi.fn(async () => [VIDEO]) });
+    const { resolveVideo } = createVersionResolver(deps);
+
+    await expect(resolveVideo(audio)).resolves.toEqual(VIDEO);
+    expect(vi.mocked(deps.searchVideos).mock.calls[0]?.[0]).toBe('kesariya arijit singh');
+  });
+
+  it('answers null when there is no video, and remembers it', async () => {
+    const deps = sources();
+    const { resolveVideo } = createVersionResolver(deps);
+
+    await expect(resolveVideo(audio)).resolves.toBeNull();
+    const calls = vi.mocked(deps.searchVideos).mock.calls.length;
+    await expect(resolveVideo(audio)).resolves.toBeNull();
+    expect(vi.mocked(deps.searchVideos).mock.calls.length).toBe(calls);
+  });
+
+  it('refuses a video of another song, or of the same song by someone else', async () => {
+    const deps = sources({
+      searchVideos: vi.fn(async () => [
+        track('other', 'Raataan Lambiyan - Shershaah | Official Video', 'Jubin Nautiyal', 271),
+        track('cover', 'Kesariya - Cover', 'Some Cover Band', 268),
+      ]),
+    });
+    const { resolveVideo } = createVersionResolver(deps);
+
+    await expect(resolveVideo(audio)).resolves.toBeNull();
+  });
+});
diff --git a/web/app/src/data/music/versions.ts b/web/app/src/data/music/versions.ts
new file mode 100644
index 0000000..f01b3e2
--- /dev/null
+++ b/web/app/src/data/music/versions.ts
@@ -0,0 +1,204 @@
+/**
+ * The other cut of a track, as the app looks it up: YouTube Music's own
+ * pairing when it offers one, otherwise a search (YtMusicRepository's
+ * resolveAudio / resolveVideo / officialVersion).
+ *
+ * The pair is asked for first because it is an answer rather than a guess: a
+ * search can land on a same-titled cover or a different release, the pair
+ * cannot. Signed out, YouTube pairs nothing at all, and the search below is
+ * the only way through — which is why the phone's own docs say so
+ * (InnertubeParser.parseVersionPair) and Android falls back to a search.
+ *
+ * Split out of api.ts so the decision flow can be tested with a mocked
+ * search: the caches are per-resolver, and api.ts owns the one the app uses.
+ */
+
+import type { Cut } from '@/data/music/api';
+import type { Track } from '@/data/music/types';
+import { best, bestOfficialAudioForVideo, queries, targetOf, type MatchCandidate, type MatchTarget } from '@/data/match/trackMatcher';
+import { trackLog } from '@/playback/trackLog';
+
+/** What a resolver asks YouTube for; api.ts binds these to the real calls. */
+export interface VersionSources {
+  /** Both cuts of [videoId]'s track from its watch queue, as YouTube pairs them. */
+  findCuts(videoId: string): Promise<{ self: Cut; other: Cut | null } | null>;
+  searchSongs(query: string): Promise<Track[]>;
+  searchVideos(query: string): Promise<Track[]>;
+}
+
+export interface VersionResolver {
+  /**
+   * [track] heard as its catalogue song: itself when it is already one, the
+   * pair's song when YouTube pairs it, otherwise the best song a search on
+   * the title and artist answers with. The same track when nothing better
+   * turns up — playing the video's own audio beats guessing at a substitute.
+   */
+  resolveAudio(track: Track): Promise<Track>;
+  /** The music video of [track], or null when none turns up. The inverse of [resolveAudio]. */
+  resolveVideo(track: Track): Promise<Track | null>;
+  /**
+   * The cut YouTube itself pairs with [videoId], or null when it paired
+   * nothing (or the lookup has not run). Only a pair YouTube made carries a
+   * time map, so this is what says whether asking for one is worth a request.
+   */
+  pairedWith(videoId: string): string | null;
+}
+
+/** A search result, plus the row it came from, so the winner can be given back as a Track. */
+interface Candidate extends MatchCandidate {
+  track: Track;
+}
+
+const asCandidate = (track: Track): Candidate => ({
+  track,
+  title: track.title,
+  artist: track.artists.map((artist) => artist.name).join(', '),
+  durationSec: track.durationSec,
+  album: track.album?.name ?? null,
+  explicit: track.explicit,
+});
+
+const describe = (error: unknown): string => (error instanceof Error ? error.message : String(error));
+
+/** What the pair lookup turned up, before any search. */
+type PairLookup = { state: 'other'; other: Cut } | { state: 'already' } | { state: 'none' };
+
+export function createVersionResolver(sources: VersionSources): VersionResolver {
+  /** Songs already found (or confirmed missing) for a video, as on the phone. */
+  const audioCache = new Map<string, Track>();
+  /** Videos found for a song; null is a real answer — there was nothing to find. */
+  const videoCache = new Map<string, Track | null>();
+  /** The counterpart YouTube itself paired with each cut it was asked about. */
+  const pairs = new Map<string, string>();
+
+  /**
+   * YtMusicRepository.officialVersion: what [track] is paired with by YouTube
+   * Music itself, as the cut [wantAudio] asks for. A failed lookup and an
+   * absent pair are both 'none', because both fall through to the search.
+   */
+  async function pairFor(track: Track, wantAudio: boolean): Promise<PairLookup> {
+    let pair: { self: Cut; other: Cut | null } | null;
+    try {
+      pair = await sources.findCuts(track.videoId);
+    } catch (error) {
+      trackLog.w(`version pair lookup failed for '${track.title}': ${describe(error)}`, track.videoId);
+      return { state: 'none' };
+    }
+    if (!pair) {
+      trackLog.d(`version pair: YouTube pairs nothing with '${track.title}'`, track.videoId);
+      return { state: 'none' };
+    }
+    // Which cut YouTube paired it with, both ways round: only a pair it made
+    // carries a time map, so this is what says whether asking for one is worth
+    // a request. (InnertubeParser.parseVersionPair's own bookkeeping.)
+    if (pair.other) {
+      pairs.set(track.videoId, pair.other.track.videoId);
+      pairs.set(pair.other.track.videoId, track.videoId);
+    }
+    // The row's own cut is the kind the track already is: nothing to switch to.
+    if (pair.self.isVideo === !wantAudio) {
+      trackLog.d(`version pair: '${track.title}' is already the ${wantAudio ? 'song' : 'video'}`, track.videoId);
+      return { state: 'already' };
+    }
+    if (!pair.other) {
+      trackLog.d(`version pair: '${track.title}' has no ${wantAudio ? 'song' : 'video'} paired with it`, track.videoId);
+      return { state: 'none' };
+    }
+    trackLog.i(`version pair: '${track.title}' -> '${pair.other.track.title}' (${pair.other.track.videoId})`, track.videoId);
+    return { state: 'other', other: pair.other };
+  }
+
+  /**
+   * The best of one search's answer: the ordinary matcher first, then the
+   * looser one the manual switch runs on, which accepts a video's visual
+   * intro or outro as a difference in runtime rather than in recording.
+   */
+  function pick(candidates: Track[], target: MatchTarget): Track | null {
+    const scored = candidates.map(asCandidate);
+    const exact = best(scored, target);
+    if (exact) return exact.track;
+    const drifted = bestOfficialAudioForVideo(scored, target);
+    if (drifted) return drifted.track;
+    return null;
+  }
+
+  return {
+    pairedWith: (videoId) => pairs.get(videoId) ?? null,
+
+    async resolveAudio(track) {
+      const cached = audioCache.get(track.videoId);
+      if (cached) return cached;
+
+      const pair = await pairFor(track, true);
+      if (pair.state === 'already') return track;
+      if (pair.state === 'other') {
+        audioCache.set(track.videoId, pair.other.track);
+        return pair.other.track;
+      }
+
+      const target = targetOf({ ...track, isVideo: true });
+      let searchFailed = false;
+      for (const query of queries(target)) {
+        trackLog.d(`audio switch: searching songs for '${query}'`, track.videoId);
+        let candidates: Track[];
+        try {
+          candidates = await sources.searchSongs(query);
+        } catch (error) {
+          // A search that failed says nothing about the song, so it must not
+          // be remembered as "this video has no song".
+          searchFailed = true;
+          trackLog.w(`audio switch: song search failed for '${query}': ${describe(error)}`, track.videoId);
+          continue;
+        }
+        const match = pick(candidates, target);
+        if (match) {
+          trackLog.i(`audio switch: '${track.title}' -> '${match.title}' (${query})`, track.videoId);
+          audioCache.set(track.videoId, match);
+          return match;
+        }
+        trackLog.d(`audio switch: no match among ${candidates.length} for '${query}'`, track.videoId);
+      }
+      trackLog.w(`audio switch: no official song match for '${track.title}' by '${target.artist ?? ''}'`, track.videoId);
+      if (!searchFailed) audioCache.set(track.videoId, track);
+      return track;
+    },
+
+    async resolveVideo(track) {
+      if (videoCache.has(track.videoId)) return videoCache.get(track.videoId) ?? null;
+
+      const pair = await pairFor(track, false);
+      if (pair.state === 'already') {
+        videoCache.set(track.videoId, null);
+        return null;
+      }
+      if (pair.state === 'other') {
+        videoCache.set(track.videoId, pair.other.track);
+        return pair.other.track;
+      }
+
+      const target = targetOf({ ...track, isVideo: false });
+      let searchFailed = false;
+      for (const query of queries(target)) {
+        trackLog.d(`video switch: searching videos for '${query}'`, track.videoId);
+        let candidates: Track[];
+        try {
+          candidates = await sources.searchVideos(query);
+        } catch (error) {
+          searchFailed = true;
+          trackLog.w(`video switch: video search failed for '${query}': ${describe(error)}`, track.videoId);
+          continue;
+        }
+        const match = best(candidates.map(asCandidate), target);
+        if (match) {
+          trackLog.i(`video switch: '${track.title}' -> '${match.track.title}' (${query})`, track.videoId);
+          videoCache.set(track.videoId, match.track);
+          return match.track;
+        }
+        trackLog.d(`video switch: no match among ${candidates.length} for '${query}'`, track.videoId);
+      }
+      trackLog.w(`video switch: no video match for '${track.title}' by '${target.artist ?? ''}'`, track.videoId);
+      if (!searchFailed) videoCache.set(track.videoId, null);
+      return null;
+    },
+  };
+}
diff --git a/web/app/src/lyrics/am-lyrics-translation.test.ts b/web/app/src/lyrics/am-lyrics-translation.test.ts
new file mode 100644
index 0000000..58905a7
--- /dev/null
+++ b/web/app/src/lyrics/am-lyrics-translation.test.ts
@@ -0,0 +1,57 @@
+// @vitest-environment happy-dom
+/**
+ * am-lyrics against the document we write: the second language has to come out
+ * as its own line under the main one, from `showTranslation` alone and with no
+ * request of the library's own. This is the library's parser doing the reading,
+ * not ours — if the shape drifts, this fails even though the strings match.
+ */
+import '@uimaxbai/am-lyrics/am-lyrics.js';
+import { describe, expect, it } from 'vitest';
+import { layoutTtml } from './layout';
+import { line } from './model';
+
+type LyricsElement = HTMLElement & {
+  ttml?: string;
+  showTranslation?: boolean;
+  noAutoAlternates?: boolean;
+  updateComplete?: Promise<unknown>;
+  shadowRoot: ShadowRoot;
+};
+
+const original = [line(1_000, 'Hello there'), line(3_000, 'We were young')];
+const translated = [line(1_000, 'سلام دنیا'), line(3_000, 'ما جوان بودیم')];
+
+async function render(layout: 'original-first' | 'translation-first'): Promise<LyricsElement> {
+  const { ttml } = layoutTtml(original, translated, layout, { source: 'en', target: 'fa' });
+  const el = document.createElement('am-lyrics') as LyricsElement;
+  el.ttml = ttml;
+  // What the panel sets: both languages are already in the document.
+  el.noAutoAlternates = true;
+  el.showTranslation = true;
+  document.body.append(el);
+  await el.updateComplete;
+  await new Promise((resolve) => setTimeout(resolve, 50));
+  return el;
+}
+
+const mains = (el: LyricsElement) =>
+  [...el.shadowRoot.querySelectorAll('.main-vocal-container')].map((node) => node.textContent?.trim());
+
+const seconds = (el: LyricsElement) =>
+  [...el.shadowRoot.querySelectorAll('.lyrics-translation-container')].map((node) => node.textContent?.trim());
+
+describe('am-lyrics with both languages', () => {
+  it('draws the translation under the original', async () => {
+    const el = await render('original-first');
+    expect(mains(el)).toEqual(['Hello there', 'We were young']);
+    expect(seconds(el)).toEqual(['سلام دنیا', 'ما جوان بودیم']);
+  });
+
+  it('draws the original under the translation, as the right-to-left lyric', async () => {
+    const el = await render('translation-first');
+    expect(mains(el)).toEqual(['سلام دنیا', 'ما جوان بودیم']);
+    expect(seconds(el)).toEqual(['Hello there', 'We were young']);
+    // The bold line is Persian, so the library itself marks it right to left.
+    expect(el.shadowRoot.querySelector('.lyrics-line.rtl-text')).not.toBeNull();
+  });
+}, 30_000);
diff --git a/web/app/src/lyrics/layout.test.ts b/web/app/src/lyrics/layout.test.ts
new file mode 100644
index 0000000..69a9f43
--- /dev/null
+++ b/web/app/src/lyrics/layout.test.ts
@@ -0,0 +1,133 @@
+// @vitest-environment happy-dom
+/**
+ * The two-language documents: which line is the bold one, which is the line
+ * under it, and that neither loses a timing. am-lyrics reads the second
+ * language only from `<text for>`/`itunes:key`, so that mapping is what these
+ * check — plus the three layouts' one difference, which version is the main one.
+ */
+import { describe, expect, it } from 'vitest';
+import { layoutTtml } from './layout';
+import { line, type LyricLine, type LyricWord } from './model';
+
+const word = (text: string, startMs: number, endMs: number): LyricWord => ({ text, startMs, endMs, syllables: [] });
+
+/** Two sung lines, an instrumental stretch, a line without words, and a line both languages share. */
+const original: LyricLine[] = [
+  line(1_000, 'Hello there', { words: [word('Hello', 1_000, 1_400), word('there', 1_400, 1_800)] }),
+  line(2_000, ''),
+  line(3_000, 'Not a word'),
+  line(4_000, 'Same', { words: [word('Same', 4_000, 4_500)] }),
+];
+
+/** The same song in Persian: same positions, same timings, same blank. */
+const translated: LyricLine[] = [
+  line(1_000, 'سلام دنیا', { words: [word('سلام', 1_000, 1_400), word('دنیا', 1_400, 1_800)] }),
+  line(2_000, ''),
+  line(3_000, 'یک کلمه نیست'),
+  line(4_000, 'Same'),
+];
+
+const laid = (layout: 'original-first' | 'translation-first' | 'translation-only', from = 'en', to = 'fa') =>
+  layoutTtml(original, translated, layout, { source: from, target: to });
+
+const keysOf = (ttml: string) => [...ttml.matchAll(/itunes:key="([^"]+)"/g)].map((match) => match[1]!);
+const targetsOf = (ttml: string) => [...ttml.matchAll(/<text for="([^"]+)"/g)].map((match) => match[1]!);
+
+describe('original-first', () => {
+  const { ttml, rtl, secondaryRtl, bilingual } = laid('original-first');
+
+  it('keeps the original as the main line, word timings and all', () => {
+    expect(ttml).toContain('xml:lang="en"');
+    expect(ttml).toContain('<p begin="1.000" end="1.800" itunes:key="L1">');
+    expect(ttml).toContain('<span begin="1.000" end="1.400">Hello</span> <span begin="1.400" end="1.800">there</span>');
+    expect(ttml).not.toContain('سلام دنیا</span>');
+  });
+
+  it('puts the translation under each line, in its own language', () => {
+    expect(ttml).toContain('<translation xml:lang="fa">');
+    expect(ttml).toContain('<text for="L1">سلام دنیا</text>');
+    expect(ttml).toContain('<text for="L2">یک کلمه نیست</text>');
+    expect(bilingual).toBe(true);
+    expect(rtl).toBe(false);
+    expect(secondaryRtl).toBe(true);
+  });
+
+  it('leaves the instrumental stretch out of both languages', () => {
+    expect(ttml.match(/<p /g)).toHaveLength(3);
+    expect(targetsOf(ttml)).toEqual(['L1', 'L2']);
+    expect(keysOf(ttml)).toEqual(['L1', 'L2', 'L3']);
+  });
+
+  it('says nothing under a line that reads the same in both languages', () => {
+    expect(ttml).not.toContain('<text for="L3">');
+    // The shared line is still the bold one, timed as it was.
+    expect(ttml).toContain('<p begin="4.000" end="4.500" itunes:key="L3">');
+  });
+
+  it('maps every translation to a paragraph am-lyrics will find', () => {
+    const document = new DOMParser().parseFromString(ttml, 'text/xml');
+    expect(document.getElementsByTagName('parsererror')).toHaveLength(0);
+    const paragraphs = new Set(keysOf(ttml));
+    for (const target of targetsOf(ttml)) expect(paragraphs.has(target)).toBe(true);
+    // What the panel reads: the same `getElementsByTagName` walk it does.
+    const texts = document.getElementsByTagName('translation')[0]!.getElementsByTagName('text');
+    expect(Array.from(texts).map((node) => [node.getAttribute('for'), node.textContent])).toEqual([
+      ['L1', 'سلام دنیا'],
+      ['L2', 'یک کلمه نیست'],
+    ]);
+  });
+});
+
+describe('translation-first', () => {
+  const { ttml, rtl, secondaryRtl, bilingual } = laid('translation-first');
+
+  it('makes the translation the main line, with the timing it was given', () => {
+    expect(ttml).toContain('xml:lang="fa"');
+    expect(ttml).toContain('<p begin="1.000" end="1.800" itunes:key="L1">');
+    expect(ttml).toContain('<span begin="1.000" end="1.400">سلام</span> <span begin="1.400" end="1.800">دنیا</span>');
+    expect(rtl).toBe(true);
+    expect(secondaryRtl).toBe(false);
+    expect(bilingual).toBe(true);
+  });
+
+  it('puts the original under it', () => {
+    expect(ttml).toContain('<translation xml:lang="en">');
+    expect(ttml).toContain('<text for="L1">Hello there</text>');
+    expect(ttml).toContain('<text for="L2">Not a word</text>');
+  });
+
+  it('leaves the same blanks blank', () => {
+    expect(ttml.match(/<p /g)).toHaveLength(3);
+    expect(targetsOf(ttml)).toEqual(['L1', 'L2']);
+  });
+});
+
+describe('translation-only', () => {
+  const { ttml, rtl, bilingual } = laid('translation-only');
+
+  it('is the document the panel showed before there were two languages', () => {
+    expect(ttml).not.toContain('<translations>');
+    expect(ttml).not.toContain('itunes:key');
+    expect(ttml).toContain('xml:lang="fa"');
+    expect(ttml).toContain('<p begin="1.000" end="1.800"><span begin="1.000" end="1.400">سلام</span>');
+    expect(bilingual).toBe(false);
+    expect(rtl).toBe(true);
+  });
+
+  it('keeps the blank out of the document', () => {
+    expect(ttml.match(/<p /g)).toHaveLength(3);
+  });
+});
+
+describe('untimed lyrics', () => {
+  it('still lets each paragraph carry its translation', () => {
+    const plain = [line(0, 'One'), line(0, ''), line(0, 'Two')];
+    const sameInPersian = [line(0, 'یک'), line(0, ''), line(0, 'دو')];
+    const { ttml } = layoutTtml(plain, sameInPersian, 'original-first', { source: 'en', target: 'fa' });
+    expect(ttml).toContain('itunes:timing="None"');
+    expect(ttml).toContain('<p itunes:key="L1">One</p>');
+    expect(ttml).toContain('<text for="L2">دو</text>');
+    // The blank line is not a paragraph, so it never takes a key.
+    expect(ttml.match(/<p /g)).toHaveLength(2);
+  });
+});
diff --git a/web/app/src/lyrics/layout.ts b/web/app/src/lyrics/layout.ts
