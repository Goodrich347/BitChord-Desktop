+++ b/web/app/src/data/music/timeMap.test.ts
@@ -0,0 +1,132 @@
+import { describe, expect, it } from 'vitest';
+import { VersionTimeMap, timeMapOf, timeMapsOf } from './timeMap';
+
+// Ported from shared/…/VersionPairTest.kt (timeMap_landsWhereTheMusicResumes…)
+// and InnertubeParser.timeMapOf: the segmentMap YouTube's own Song/Video
+// switch seeks with, read off a raw /next response.
+
+const map = new VersionTimeMap([
+  { fromStartMs: 10_000, toStartMs: 0, durationMs: 60_000 },
+  // A 20s skit in the video between the two halves.
+  { fromStartMs: 90_000, toStartMs: 60_000, durationMs: 60_000 },
+]);
+
+describe('VersionTimeMap', () => {
+  it('lands where the music resumes outside a stretch', () => {
+    expect(map.map(3_000)).toBe(0); // intro
+    expect(map.map(60_000)).toBe(50_000); // first half
+    expect(map.map(80_000)).toBe(60_000); // skit
+    expect(map.map(120_000)).toBe(90_000); // second half
+    expect(map.map(200_000)).toBe(120_000); // outro
+    expect(map.inverted().map(90_000)).toBe(120_000);
+  });
+
+  it('needs at least one segment', () => {
+    expect(() => new VersionTimeMap([])).toThrow();
+  });
+});
+
+const counterpart = (videoId: string, segmentMap?: unknown) => ({
+  counterpartRenderer: { playlistPanelVideoRenderer: { videoId } },
+  ...(segmentMap ? { segmentMap } : {}),
+});
+
+const segments = {
+  segment: [
+    // protobuf writes int64s as strings, which both forms must survive.
+    { primaryVideoStartTimeMilliseconds: '10000', counterpartVideoStartTimeMilliseconds: '0', durationMilliseconds: '60000' },
+    { primaryVideoStartTimeMilliseconds: 90_000, counterpartVideoStartTimeMilliseconds: 60_000, durationMilliseconds: 60_000 },
+  ],
+};
+
+describe('timeMapOf', () => {
+  it('reads a counterpart’s segments, skipping the ones it cannot use', () => {
+    const read = timeMapOf({ segmentMap: { segment: [...segments.segment, { primaryVideoStartTimeMilliseconds: '1' }] } });
+    expect(read?.segments).toHaveLength(2);
+    expect(read?.map(120_000)).toBe(90_000);
+  });
+
+  it('gives nothing for a counterpart without a map', () => {
+    expect(timeMapOf(counterpart('song1'))).toBeNull();
+  });
+});
+
+describe('timeMapsOf', () => {
+  const root = {
+    contents: {
+      wrapper: [
+        { playlistPanelVideoWrapperRenderer: { primaryRenderer: { playlistPanelVideoRenderer: { videoId: 'vid1' } }, counterpart: [counterpart('song1', segments)] } },
+        { playlistPanelVideoWrapperRenderer: { primaryRenderer: { playlistPanelVideoRenderer: { videoId: 'other' } }, counterpart: [counterpart('vid2', segments)] } },
+      ],
+    },
+  };
+
+  // The canonical pair, as VersionPairTest.kt words it: the video opens on 12s
+  // of dialogue and the two cuts run the same 180s after that.
+  const pair = (primary: string, counterpartId: string) => ({
+    contents: [
+      {
+        playlistPanelVideoWrapperRenderer: {
+          primaryRenderer: { playlistPanelVideoRenderer: { videoId: primary } },
+          counterpart: [
+            {
+              counterpartRenderer: { playlistPanelVideoRenderer: { videoId: counterpartId } },
+              segmentMap: {
+                segment: [
+                  {
+                    primaryVideoStartTimeMilliseconds: '12000',
+                    counterpartVideoStartTimeMilliseconds: '0',
+                    durationMilliseconds: '180000',
+                  },
+                ],
+              },
+            },
+          ],
+        },
+      },
+    ],
+  });
+
+  it('maps the video’s dialogue intro to the start of the song', () => {
+    expect(timeMapsOf(pair('omv1', 'atv1'), 'omv1').get('atv1')?.map(42_000)).toBe(30_000);
+  });
+
+  it('reads it backwards when YouTube put the song first', () => {
+    const songFirst = {
+      contents: [
+        {
+          playlistPanelVideoWrapperRenderer: {
+            primaryRenderer: { playlistPanelVideoRenderer: { videoId: 'atv1' } },
+            counterpart: [
+              {
+                counterpartRenderer: { playlistPanelVideoRenderer: { videoId: 'omv1' } },
+                segmentMap: {
+                  segment: [
+                    {
+                      primaryVideoStartTimeMilliseconds: 0,
+                      counterpartVideoStartTimeMilliseconds: 12000,
+                      durationMilliseconds: 180000,
+                    },
+                  ],
+                },
+              },
+            ],
+          },
+        },
+      ],
+    };
+    expect(timeMapsOf(songFirst, 'omv1').get('atv1')?.map(42_000)).toBe(30_000);
+  });
+
+  it('maps the track asked about to the cut it is paired with', () => {
+    expect(timeMapsOf(root, 'vid1').get('song1')?.map(120_000)).toBe(90_000);
+  });
+
+  it('reads the map backwards when the track is the counterpart', () => {
+    expect(timeMapsOf(root, 'vid2').get('other')?.map(90_000)).toBe(120_000);
+  });
+
+  it('gives nothing when YouTube pairs it with nothing', () => {
+    expect(timeMapsOf({ contents: [{ playlistPanelVideoRenderer: { videoId: 'vid1' } }] }, 'vid1').size).toBe(0);
+  });
+});
diff --git a/web/app/src/data/music/timeMap.ts b/web/app/src/data/music/timeMap.ts
new file mode 100644
index 0000000..4ad7954
--- /dev/null
+++ b/web/app/src/data/music/timeMap.ts
@@ -0,0 +1,124 @@
+/**
+ * YouTube Music's own word on how a music video and the song it is a video of
+ * line up — the `segmentMap` its Song/Video switch reads. A port of
+ * VersionTimeMap.kt and InnertubeParser.timeMapOf.
+ *
+ * Nothing is measured to get this: it arrives with the version pair itself, so
+ * a switch that has one lands on the same moment without fetching or decoding
+ * either stream. YouTube.js's parser drops the map (it only keeps the parsed
+ * rows), so api.ts reads it off the raw `/next` response and hands the object
+ * to `timeMapsOf` here.
+ */
+
+/** A stretch both cuts share, [durationMs] long in each. */
+export interface TimeSegment {
+  fromStartMs: number;
+  toStartMs: number;
+  durationMs: number;
+}
+
+export class VersionTimeMap {
+  /** Sorted by where each stretch starts in the cut this map reads from. */
+  readonly segments: readonly TimeSegment[];
+
+  constructor(segments: readonly TimeSegment[]) {
+    if (!segments.length) throw new Error('a time map needs at least one segment');
+    this.segments = [...segments].sort((a, b) => a.fromStartMs - b.fromStartMs);
+  }
+
+  /**
+   * Where [positionMs] in the playing cut falls in the other one.
+   *
+   * Inside a shared stretch it is exact. Outside one — a video's spoken intro,
+   * a skit between verses — there is no matching moment, so it lands where the
+   * music picks up again; past the last stretch, at its end.
+   */
+  map(positionMs: number): number {
+    for (const segment of this.segments) {
+      if (positionMs < segment.fromStartMs) return segment.toStartMs;
+      const into = positionMs - segment.fromStartMs;
+      if (into < segment.durationMs) return segment.toStartMs + into;
+    }
+    const last = this.segments[this.segments.length - 1]!;
+    return last.toStartMs + last.durationMs;
+  }
+
+  /** The same pairing read from the other side. */
+  inverted(): VersionTimeMap {
+    return new VersionTimeMap(this.segments.map((s) => ({ fromStartMs: s.toStartMs, toStartMs: s.fromStartMs, durationMs: s.durationMs })));
+  }
+}
+
+type Raw = Record<string, unknown>;
+
+const object = (value: unknown): Raw | null => (value && typeof value === 'object' && !Array.isArray(value) ? (value as Raw) : null);
+const array = (value: unknown): unknown[] => (Array.isArray(value) ? value : []);
+
+/** Protobuf writes int64s as JSON strings; both forms are read, as on the phone. */
+function milliseconds(value: unknown): number | null {
+  const number = typeof value === 'string' && value.trim() ? Number(value) : typeof value === 'number' ? value : NaN;
+  return Number.isFinite(number) ? number : null;
+}
+
+/**
+ * A counterpart's `segmentMap`: where every stretch the two share starts in
+ * each, and how long it runs. Null when there is no map (every signed-out
+ * response, and anything YouTube does not consider a version of the other).
+ */
+export function timeMapOf(counterpart: unknown): VersionTimeMap | null {
+  const segments = array(object(object(counterpart)?.segmentMap)?.segment).flatMap((entry) => {
+    const segment = object(entry);
+    const fromStartMs = milliseconds(segment?.primaryVideoStartTimeMilliseconds);
+    const toStartMs = milliseconds(segment?.counterpartVideoStartTimeMilliseconds);
+    const durationMs = milliseconds(segment?.durationMilliseconds);
+    if (fromStartMs === null || toStartMs === null || durationMs === null || durationMs <= 0) return [];
+    return [{ fromStartMs, toStartMs, durationMs }];
+  });
+  return segments.length ? new VersionTimeMap(segments) : null;
+}
+
+/** Every object stored under [key], anywhere inside a raw response (api.ts's `collect`). */
+function collect(root: unknown, key: string, out: Raw[] = []): Raw[] {
+  if (Array.isArray(root)) for (const item of root) collect(item, key, out);
+  else if (root && typeof root === 'object') {
+    for (const [k, v] of Object.entries(root)) {
+      if (k === key && v && typeof v === 'object' && !Array.isArray(v)) out.push(v as Raw);
+      else collect(v, key, out);
+    }
+  }
+  return out;
+}
+
+/** The `playlistPanelVideoRenderer` a wrapper half carries, if any. */
+const panelOf = (half: unknown): Raw | null => {
+  const renderer = object(object(half)?.playlistPanelVideoRenderer);
+  return typeof renderer?.videoId === 'string' ? renderer : null;
+};
+
+/**
+ * InnertubeParser.parseVersionPair's map bookkeeping: from [videoId], the time
+ * map to every cut YouTube pairs it with in this response.
+ *
+ * The pair can come back either way round — the track asked about as the row's
+ * primary with the other version as its counterpart, or the other way, in
+ * which case the map is read backwards.
+ */
+export function timeMapsOf(root: unknown, videoId: string): Map<string, VersionTimeMap> {
+  const out = new Map<string, VersionTimeMap>();
+  for (const wrapper of collect(root, 'playlistPanelVideoWrapperRenderer')) {
+    const primary = panelOf(wrapper.primaryRenderer);
+    const counterparts = array(wrapper.counterpart).map((entry) => ({ node: entry, panel: panelOf(object(entry)?.counterpartRenderer) }));
+    if (primary?.videoId === videoId) {
+      for (const counterpart of counterparts) {
+        const map = timeMapOf(counterpart.node);
+        if (map && counterpart.panel) out.set(counterpart.panel.videoId as string, map);
+      }
+      continue;
+    }
+    const asCounterpart = counterparts.find((entry) => entry.panel?.videoId === videoId);
+    if (!asCounterpart || !primary) continue;
+    const map = timeMapOf(asCounterpart.node)?.inverted();
+    if (map) out.set(primary.videoId as string, map);
+  }
+  return out;
+}
