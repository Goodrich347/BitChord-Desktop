index 0000000..1663633
--- /dev/null
+++ b/web/app/src/lyrics/useTranslation.ts
@@ -0,0 +1,162 @@
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { create } from 'zustand';
+import { layoutTtml } from './layout';
+import type { LyricLine } from './model';
+import type { LyricsResult } from './repository';
+import { useLyricsSettings } from './settings';
+import { languageLabel, translateLyrics } from './translation';
+
+/**
+ * Which version the panel is showing, as `videoId|destination`: kept outside
+ * the component so opening the full-screen player (or closing it) does not
+ * quietly put the original back, as the phone's player doesn't.
+ */
+const useTranslatedChoice = create<{
+  token: string | null;
+  /** The song switched back to its original (or that failed) while Always translate is on. */
+  dismissed: string | null;
+  setToken: (token: string | null) => void;
+  setDismissed: (token: string | null) => void;
+}>((set) => ({
+  token: null,
+  dismissed: null,
+  setToken: (token) => set({ token }),
+  setDismissed: (dismissed) => set({ dismissed }),
+}));
+
+/** Back to no song chosen or dismissed: for tests, which share the store. */
+export function forgetTranslatedChoice(): void {
+  useTranslatedChoice.setState({ token: null, dismissed: null });
+}
+
+/**
+ * The panel's translated view: which version is showing, what the request is
+ * doing, and the one short message its failures leave behind.
+ *
+ * A change of track, lyrics or destination language cancels the request in
+ * flight (the effect's cleanup aborts it), so an answer for the last song can
+ * never land on this one. A second toggle is answered from the cache, with no
+ * request at all. The layout is applied to the answer here, so switching
+ * between `original-first`, `translation-first` and `translation-only` never
+ * asks Google anything.
+ */
+export interface LyricsTranslation {
+  /** Whether the translated version is the one on screen. */
+  showing: boolean;
+  /** Whether there are any lyrics to translate. */
+  available: boolean;
+  pending: boolean;
+  notice: string | null;
+  /** The TTML for the current destination and layout, once it is ready. */
+  ttml: string | null;
+  /** Whether the main line is right to left. */
+  rtl: boolean;
+  /** Whether the line under it is right to left (Persian under an English lyric). */
+  secondaryRtl: boolean;
+  /** Whether am-lyrics should draw the second line (i.e. every layout but `translation-only`). */
+  bilingual: boolean;
+  target: string;
+  setTarget: (language: string) => void;
+  toggle: () => void;
+}
+
+interface Ready {
+  /** The destination it was translated into, so a language change never shows the old one. */
+  target: string;
+  /** The same lines, in that language, with their timings. */
+  lines: LyricLine[];
+  /** The language they were translated from, as Google detected it. */
+  source: string;
+}
+
+export function useLyricsTranslation(result: LyricsResult | null | undefined, videoId: string): LyricsTranslation {
+  const target = useLyricsSettings((s) => s.translateTo);
+  const setTarget = useLyricsSettings((s) => s.setTranslateTo);
+  const layout = useLyricsSettings((s) => s.translationLayout);
+  const token = `${videoId}|${target}`;
+  const chosen = useTranslatedChoice((s) => s.token);
+  const setToken = useTranslatedChoice((s) => s.setToken);
+  const dismissed = useTranslatedChoice((s) => s.dismissed);
+  const setDismissed = useTranslatedChoice((s) => s.setDismissed);
+  const always = useLyricsSettings((s) => s.alwaysTranslate);
+  const [pending, setPending] = useState(false);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [ready, setReady] = useState<Ready | null>(null);
+  const manual = chosen === token;
+  const showing = !!result && !!videoId && dismissed !== token && (manual || always);
+
+  // New lyrics mean the text in hand belongs to another song.
+  useEffect(() => {
+    setReady(null);
+  }, [result]);
+
+  useEffect(() => {
+    if (!showing || !result) return;
+    const controller = new AbortController();
+    setPending(true);
+    setNotice(null);
+    // Dismissed as well as unchosen, so Always translate doesn't ask again for this song.
+    const fail = (message: string | null) => {
+      setNotice(message);
+      setToken(null);
+      setDismissed(token);
+    };
+    translateLyrics({ videoId, lines: result.lines, target, signal: controller.signal })
+      .then((outcome) => {
+        if (controller.signal.aborted) return;
+        if (outcome.kind === 'translated') {
+          setReady({ target, lines: outcome.lines, source: outcome.sourceLanguage });
+        } else if (outcome.kind === 'same') {
+          // Said when asked for; with Always translate a song already in the language just stays as it is.
+          fail(manual ? `Already in ${languageLabel(outcome.language)}.` : null);
+        } else if (outcome.reason !== 'cancelled') {
+          fail('Translation is unavailable right now. Showing the original lyrics.');
+        }
+      })
+      .catch(() => {
+        if (!controller.signal.aborted) fail('Translation is unavailable right now. Showing the original lyrics.');
+      })
+      .finally(() => {
+        if (!controller.signal.aborted) setPending(false);
+      });
+    return () => controller.abort();
+  }, [showing, result, videoId, target, token, manual, setToken, setDismissed]);
+
+  // Composed from the answer already in hand: a layout change is a re-render, not a request.
+  // Gated on `showing`: with the translation off the panel gets no document from
+  // here and falls back to the original, which is the whole point of the toggle.
+  const current = showing && ready && ready.target === target ? ready : null;
+  const laid = useMemo(
+    () =>
+      current && result
+        ? layoutTtml(result.lines, current.lines, layout, { source: current.source, target })
+        : null,
+    [current, result, layout, target],
+  );
+
+  const toggle = useCallback(() => {
+    if (!result) return;
+    setNotice(null);
+    if (showing) {
+      setToken(null);
+      setDismissed(token);
+    } else {
+      setDismissed(null);
+      setToken(token);
+    }
+  }, [result, showing, token, setToken, setDismissed]);
+
+  return {
+    showing: showing && !!laid,
+    available: !!result,
+    pending,
+    notice,
+    ttml: laid?.ttml ?? null,
+    rtl: laid?.rtl ?? false,
+    secondaryRtl: laid?.secondaryRtl ?? false,
+    bilingual: laid?.bilingual ?? false,
+    target,
+    setTarget,
+    toggle,
+  };
+}
