@@ -0,0 +1,180 @@
+import { create } from 'zustand';
+import type { Track } from '@/data/music/types';
+import { trackLog } from '@/playback/trackLog';
+import { useVideo } from '@/state/video';
+
+/**
+ * "Prefer song over music video" (playback/MusicOnlyPlayback.kt): a music
+ * video in the queue is heard as its catalogue song instead, resolved before
+ * its stream is asked for. The listener can still switch a track between its
+ * two cuts by hand from the player's menu, and that choice sticks.
+ *
+ * The song is found through the video's own watch queue when YouTube pairs the
+ * two (findCuts, data/music/api.ts) and by a search on the title and artist
+ * when it doesn't (resolveAudio, data/music/versions.ts) — signed out, YouTube
+ * pairs nothing at all, and the search is the only way through.
+ */
+
+const SETTING_KEY = 'bitchord:music-only';
+
+/**
+ * How long a video waits for its song before it plays as itself, when nothing
+ * is holding playback for it (MusicOnlyPlayback.ANSWER_TIMEOUT_MS).
+ */
+export const ANSWER_TIMEOUT_MS = 15_000;
+
+/**
+ * How long the *playing* row waits. A pair answers well inside this; the
+ * search fallback can take longer, and holding playback silent that long is
+ * worse than playing the video this time — the answer still lands in the
+ * resolver's cache, so the next play of the track converts.
+ */
+const PLAYING_ANSWER_TIMEOUT_MS = 4_000;
+
+/** Whether the lookup gave up waiting rather than answered. */
+const TIMED_OUT = Symbol('timed out');
+
+/** Which recording a track is, once anything has said. */
+export type CutKind = 'song' | 'video';
+
+interface MusicOnlyState {
+  preferMusicOnly: boolean;
+  /** Videos the listener switched to by hand: they stay videos. */
+  kept: ReadonlySet<string>;
+  /** Tracks with nothing left to ask: a song, a video with no song, or a lookup that answered nothing. */
+  settled: ReadonlySet<string>;
+  /** What each resolved track is, for the player menu's label. */
+  kinds: Record<string, CutKind>;
+  setPreferMusicOnly: (on: boolean) => void;
+  keep: (videoId: string) => void;
+  letGo: (videoId: string) => void;
+  settle: (videoId: string) => void;
+  remember: (videoId: string, kind: CutKind) => void;
+}
+
+const stored = (): boolean => {
+  try {
+    return localStorage.getItem(SETTING_KEY) === '1';
+  } catch {
+    return false;
+  }
+};
+
+/** Off by default, as on the phone; the setting is the listener's to turn on. */
+export const useMusicOnly = create<MusicOnlyState>()((set) => ({
+  preferMusicOnly: stored(),
+  kept: new Set(),
+  settled: new Set(),
+  kinds: {},
+
+  setPreferMusicOnly(preferMusicOnly) {
+    try {
+      localStorage.setItem(SETTING_KEY, preferMusicOnly ? '1' : '0');
+    } catch {
+      // Private browsing: the setting holds for this session.
+    }
+    // Nothing decided under the old value stands (MusicOnlyPlayback.reset).
+    set({ preferMusicOnly, kept: new Set(), settled: new Set() });
+  },
+
+  keep: (videoId) => set((s) => ({ kept: new Set(s.kept).add(videoId) })),
+  letGo: (videoId) =>
+    set((s) => {
+      if (!s.kept.has(videoId)) return s;
+      const kept = new Set(s.kept);
+      kept.delete(videoId);
+      return { kept };
+    }),
+  settle: (videoId) => set((s) => ({ settled: new Set(s.settled).add(videoId) })),
+  remember: (videoId, kind) => set((s) => ({ kinds: { ...s.kinds, [videoId]: kind } })),
+}));
+
+/**
+ * Whether a music video should play as its song: the setting is on, and never
+ * in a Listen Together party, where everyone hears the one cut.
+ */
+export function musicOnlyActive(inParty: boolean): boolean {
+  return useMusicOnly.getState().preferMusicOnly && !inParty;
+}
+
+/**
+ * Which cut [track] is, as far as the app can tell: what its row's queue said
+ * when it was looked up, then its picture being up (a music video's, which a
+ * catalogue song never has), then the catalogue's own tell — a row filed under
+ * an album is the song, an album-less one can only be the video.
+ *
+ * [known] and [picture] are passed in rather than read here so components can
+ * subscribe to them and re-render on the answer.
+ */
+export function kindFrom(known: CutKind | undefined, picture: boolean, track: Pick<Track, 'album'>): CutKind {
+  if (known) return known;
+  if (picture) return 'video';
+  return track.album ? 'song' : 'video';
+}
+
+/** [kindFrom] for callers outside a component render. */
+export function kindOf(track: Track): CutKind {
+  return kindFrom(useMusicOnly.getState().kinds[track.videoId], useVideo.getState().videoId === track.videoId, track);
+}
+
+/** Lookups under way, so the playing row and the one after it don't ask twice. */
+const asking = new Map<string, Promise<Track | null | typeof TIMED_OUT>>();
+
+/**
+ * [track]'s song, asked once at a time and given [waitMs] to answer: the pair
+ * YouTube offers, or the search that stands in for it when it offers none.
+ * Null when the track has no song (or none turned up); [TIMED_OUT] when the
+ * lookup is merely still running.
+ */
+export function songCutFor(track: Track, waitMs = PLAYING_ANSWER_TIMEOUT_MS): Promise<Track | null | typeof TIMED_OUT> {
+  const running = asking.get(track.videoId);
+  if (running) return running;
+  const lookup = import('@/data/music/api')
+    .then(({ resolveAudio }) => resolveAudio(track))
+    .then((song) => (song.videoId === track.videoId ? null : song))
+    .catch((error: unknown) => {
+      trackLog.w(`song lookup failed for '${track.title}': ${error instanceof Error ? error.message : String(error)}`, track.videoId);
+      return null;
+    });
+  const answered = Promise.race([
+    lookup,
+    new Promise<typeof TIMED_OUT>((resolve) => setTimeout(() => resolve(TIMED_OUT), waitMs)),
+  ]);
+  asking.set(track.videoId, answered);
+  return answered.finally(() => asking.delete(track.videoId));
+}
+
+/**
+ * The song [track] should play as, or null when it plays as itself: it is a
+ * song, it was kept as a video by hand, or no song turned up in time. The
+ * answer is remembered, so a track is asked about once a session.
+ */
+export async function songFor(track: Track, inParty: boolean): Promise<Track | null> {
+  const { videoId } = track;
+  // A catalogue song is known at once, with no lookup: it says its album, and
+  // nothing on screen shows a picture for it.
+  if (kindOf(track) === 'song') return null;
+  if (!wantsSong(videoId, inParty)) return null;
+  const song = await songCutFor(track);
+  // The setting or the party may have changed while the answer was coming.
+  if (!wantsSong(videoId, inParty)) return null;
+  const state = useMusicOnly.getState();
+  if (song === TIMED_OUT) {
+    // Still being looked up: not settled, so the next play of it tries again
+    // (and finds the answer already cached when the lookup did land).
+    trackLog.d(`song lookup still running for '${track.title}'; playing the video`, videoId);
+    return null;
+  }
+  if (!song) {
+    state.settle(videoId);
+    return null;
+  }
+  state.remember(videoId, 'video');
+  state.remember(song.videoId, 'song');
+  return song;
+}
+
+function wantsSong(videoId: string, inParty: boolean): boolean {
+  const { kept, settled, kinds } = useMusicOnly.getState();
+  return musicOnlyActive(inParty) && !kept.has(videoId) && !settled.has(videoId) && kinds[videoId] !== 'song';
+}
