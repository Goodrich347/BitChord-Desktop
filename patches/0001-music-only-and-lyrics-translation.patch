--- /dev/null
+++ b/web/app/src/lyrics/layout.ts
@@ -0,0 +1,84 @@
+import type { LyricLine } from './model';
+import { isRtl } from './translation';
+import { writeTtml } from './ttml';
+
+/**
+ * How the two languages are stacked while the translate button is on.
+ *
+ * - `original-first`: the lyric as it is sung, bold, with the translation
+ *   under it (what Apple Music shows).
+ * - `translation-first`: the translation is the lyric, bold and sweeping, and
+ *   the original sits under it.
+ * - `translation-only`: the translated lyric replaces the original, which is
+ *   how the panel worked before there were two languages.
+ *
+ * am-lyrics draws both of the first two itself: the main line is bold and
+ * sweeps with its word timings, the `<text for>` lines are the smaller, dimmer
+ * line under it (`showTranslation`). No second element, no per-frame work.
+ */
+export type TranslationLayout = 'original-first' | 'translation-first' | 'translation-only';
+
+export const TRANSLATION_LAYOUTS: { id: TranslationLayout; label: string }[] = [
+  { id: 'original-first', label: 'Original bold, translation below' },
+  { id: 'translation-first', label: 'Translation bold, original below' },
+  { id: 'translation-only', label: 'Translation only' },
+];
+
+export const DEFAULT_TRANSLATION_LAYOUT: TranslationLayout = 'original-first';
+
+export function isTranslationLayout(value: unknown): value is TranslationLayout {
+  return TRANSLATION_LAYOUTS.some((layout) => layout.id === value);
+}
+
+export function translationLayoutLabel(layout: TranslationLayout): string {
+  return TRANSLATION_LAYOUTS.find((entry) => entry.id === layout)?.label ?? layout;
+}
+
+export interface LaidOutLyrics {
+  /** What am-lyrics renders. */
+  ttml: string;
+  /** Whether the main line reads right to left (the panel's `dir`). */
+  rtl: boolean;
+  /** Whether the line under it reads right to left (Persian under an English lyric). */
+  secondaryRtl: boolean;
+  /** Whether the document carries a second language am-lyrics should draw. */
+  bilingual: boolean;
+}
+
+/** A line's lead text, when it says anything: a blank line is an instrumental stretch. */
+function leadOf(lines: LyricLine[], index: number): string | undefined {
+  const text = lines[index]?.text.trim();
+  return text ? text : undefined;
+}
+
+/**
+ * The TTML for one layout, from both versions of the same song.
+ *
+ * [translated] is [original] with the text replaced (translation.ts'
+ * `rebuildLines`), so the two arrays are line for line: same positions, same
+ * timings, same blanks. Whichever one is the main line keeps its own word
+ * timings, which is what makes the sweep follow the vocal in either language;
+ * the other one is only text, mapped to its line by key.
+ */
+export function layoutTtml(
+  original: LyricLine[],
+  translated: LyricLine[],
+  layout: TranslationLayout,
+  { source, target }: { source: string; target: string },
+): LaidOutLyrics {
+  const translationFirst = layout === 'translation-first';
+  // The old document, unchanged: no keys, no second language.
+  if (layout === 'translation-only') {
+    return { ttml: writeTtml(translated, target), rtl: isRtl(target), secondaryRtl: false, bilingual: false };
+  }
+  const main = translationFirst ? translated : original;
+  const under = translationFirst ? original : translated;
+  const mainLanguage = translationFirst ? target : source;
+  const secondaryLanguage = translationFirst ? source : target;
+  return {
+    ttml: writeTtml(main, mainLanguage, { language: secondaryLanguage, texts: main.map((_, index) => leadOf(under, index)) }),
+    rtl: isRtl(mainLanguage),
+    secondaryRtl: isRtl(secondaryLanguage),
+    bilingual: true,
+  };
+}
