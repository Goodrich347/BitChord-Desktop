+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Track } from '@/data/music/types';
+
+// What the resolver makes of YouTube's pair and of a search is
+// data/music/versions.test.ts's own subject; what this tests is what musicOnly
+// makes of its answer: which cut plays, and when it stops asking.
+vi.mock('@/data/music/api', () => ({ resolveAudio: vi.fn() }));
+
+const { resolveAudio } = await import('@/data/music/api');
+const { kindOf, songFor, useMusicOnly } = await import('./musicOnly');
+const { useVideo } = await import('@/state/video');
+
+const track = (videoId: string, album: string | null = null): Track => ({
+  videoId,
+  title: videoId,
+  artists: [],
+  album: album ? { name: album, id: null } : null,
+  durationSec: null,
+  explicit: false,
+  thumbnail: null,
+  index: null,
+  plays: null,
+});
+
+beforeEach(() => {
+  useMusicOnly.setState({ preferMusicOnly: true, kept: new Set(), settled: new Set(), kinds: {} });
+  useVideo.setState({ videoId: null });
+  vi.mocked(resolveAudio).mockReset();
+});
+
+describe('kindOf', () => {
+  it('takes the queue’s answer, then the picture, then the catalogue’s own tell', () => {
+    expect(kindOf(track('a', 'Album'))).toBe('song');
+    expect(kindOf(track('a'))).toBe('video');
+    // A video row that names an album is still a video once its picture is up.
+    useVideo.setState({ videoId: 'a' });
+    expect(kindOf(track('a', 'Album'))).toBe('video');
+    // And what the queue said outranks both.
+    useMusicOnly.setState({ kinds: { a: 'song' } });
+    expect(kindOf(track('a'))).toBe('song');
+  });
+});
+
+describe('songFor', () => {
+  it('gives a music video its song', async () => {
+    vi.mocked(resolveAudio).mockResolvedValue(track('song'));
+    await expect(songFor(track('video'), false)).resolves.toEqual(track('song'));
+    expect(useMusicOnly.getState().kinds).toEqual({ video: 'video', song: 'song' });
+  });
+
+  it('gives a music video its song even when its row names an album, if its picture is up', async () => {
+    useVideo.setState({ videoId: 'video' });
+    vi.mocked(resolveAudio).mockResolvedValue(track('song'));
+    await expect(songFor(track('video', 'Album'), false)).resolves.toEqual(track('song'));
+  });
+
+  it('leaves a song alone without asking', async () => {
+    await expect(songFor(track('song', 'Album'), false)).resolves.toBeNull();
+    expect(resolveAudio).not.toHaveBeenCalled();
+  });
+
+  it('leaves a video with no song alone, and asks about it once', async () => {
+    vi.mocked(resolveAudio).mockResolvedValue(track('video'));
+    await expect(songFor(track('video'), false)).resolves.toBeNull();
+    await expect(songFor(track('video'), false)).resolves.toBeNull();
+    expect(resolveAudio).toHaveBeenCalledTimes(1);
+    expect(useMusicOnly.getState().settled.has('video')).toBe(true);
+  });
+
+  it('never converts with the setting off, or in a party, or once kept by hand', async () => {
+    vi.mocked(resolveAudio).mockResolvedValue(track('song'));
+    useMusicOnly.setState({ preferMusicOnly: false });
+    await expect(songFor(track('video'), false)).resolves.toBeNull();
+    useMusicOnly.setState({ preferMusicOnly: true, kept: new Set(['video']) });
+    await expect(songFor(track('video'), false)).resolves.toBeNull();
+    useMusicOnly.setState({ kept: new Set() });
+    await expect(songFor(track('video'), true)).resolves.toBeNull();
+    expect(resolveAudio).not.toHaveBeenCalled();
+  });
+
+  it('plays the video as itself when the lookup fails', async () => {
+    vi.mocked(resolveAudio).mockRejectedValue(new Error('offline'));
+    await expect(songFor(track('video'), false)).resolves.toBeNull();
+    expect(useMusicOnly.getState().settled.has('video')).toBe(true);
+  });
+
+  it('does not write off a lookup that is still running', async () => {
+    vi.useFakeTimers();
+    try {
+      vi.mocked(resolveAudio).mockReturnValue(new Promise(() => {}));
+      const answer = songFor(track('video'), false);
+      await vi.advanceTimersByTimeAsync(5_000);
+      await expect(answer).resolves.toBeNull();
+      // Nothing was said about the track, so the next play asks again.
+      expect(useMusicOnly.getState().settled.has('video')).toBe(false);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+});
