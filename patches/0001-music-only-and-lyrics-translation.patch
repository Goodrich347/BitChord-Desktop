+// @vitest-environment happy-dom
+/**
+ * The panel's translation wiring: the toggle beside the source credit asks for
+ * a translation once, swaps the TTML am-lyrics renders, and puts the original
+ * back without a second request. The providers, the player and the extension
+ * are all stubbed — this is about the panel, not about where lyrics come from.
+ */
+import { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { forgetTranslatedChoice } from '@/lyrics/useTranslation';
+import { line } from '@/lyrics/model';
+
+const lyricsResult = {
+  source: 'lrclib' as const,
+  label: 'LRCLIB',
+  lines: [line(0, 'Hello there'), line(2_000, ''), line(3_000, 'We were young')],
+  ttml: '<tt>original</tt>',
+  wordSynced: false,
+  synced: true,
+};
+
+vi.mock('@uimaxbai/am-lyrics/am-lyrics.js', () => ({}));
+vi.mock('@/data/spotify/canvas', () => ({ useCanvas: () => null }));
+vi.mock('@/extension/bridge', () => ({ getBridge: () => null }));
+vi.mock('@/lyrics/http', () => ({
+  onUngrantedChange: () => () => {},
+  ungrantedOrigins: new Set<string>(),
+  onGranted: () => () => {},
+  recheckGrants: async () => {},
+}));
+vi.mock('@/lyrics/useLyrics', () => ({
+  useLyrics: () => ({ data: lyricsResult, isPending: false, fetchStatus: 'idle', isFetching: false }),
+  useLyricsUi: (select: (state: unknown) => unknown) => select({ picked: {}, states: {}, pick: () => {} }),
+}));
+vi.mock('@/state/player', () => ({
+  usePlayer: (select: (state: unknown) => unknown) =>
+    select({
+      nowPlaying: { videoId: 'vid1', title: 'Song', artist: 'Someone' },
+      deck: null,
+      mixing: false,
+      status: 'paused',
+      queue: [],
+      index: 0,
+      seek: () => {},
+    }),
+  getAudio: () => null,
+  getPlayhead: () => null,
+}));
+
+const { LyricsPanel } = await import('./LyricsPanel');
+const { useLyricsSettings } = await import('@/lyrics/settings');
+const { forgetTranslations } = await import('@/lyrics/translation');
+
+/** Renders the side panel and returns its host element. */
+async function renderPanel(target: string, layout: 'original-first' | 'translation-first' | 'translation-only' = 'translation-only') {
+  useLyricsSettings.setState({ translateTo: target, translationLayout: layout });
+  const host = document.createElement('div');
+  document.body.append(host);
+  const root = createRoot(host);
+  await act(async () => root.render(<LyricsPanel />));
+  return { host, root };
+}
+
+describe('LyricsPanel translation', () => {
+  const requests: string[] = [];
+
+  beforeEach(() => {
+    requests.length = 0;
+    // Answers are cached per track and language; each test starts from none.
+    forgetTranslations();
+    forgetTranslatedChoice();
+    // Emptying the test's own body between renders; no page content is involved.
+    document.body.innerHTML = '';
+    Object.defineProperty(document, 'fonts', { value: { load: async () => [] }, configurable: true });
+    vi.stubGlobal('matchMedia', (query: string) => ({
+      matches: false,
+      media: query,
+      addEventListener() {},
+      removeEventListener() {},
+    }));
+    vi.stubGlobal('fetch', async (_url: string, init: RequestInit) => {
+      const payload = String((init.body as URLSearchParams).get('q'));
+      requests.push(payload);
+      // An identity answer: the endpoint hands the payload back with its markers intact.
+      return { ok: true, status: 200, json: async () => [[[payload, payload, null, null, 1]], null, 'en'] };
+    });
+  });
+
+  it('translates once, swaps the text and keeps it in place', async () => {
+    const { host, root } = await renderPanel('fa');
+    const toggle = host.querySelector('button[aria-label="Translate the lyrics"]') as HTMLElement | null;
+    expect(toggle).not.toBeNull();
+    await act(async () => toggle!.click());
+    await act(async () => {
+      await new Promise((resolve) => setTimeout(resolve, 250));
+    });
+    expect(requests).toHaveLength(1);
+    expect(host.querySelector('button[aria-label="Show the original lyrics"]')).not.toBeNull();
+    // Persian is right to left, so the canvas is told so.
+    expect(host.querySelector('am-lyrics')?.getAttribute('dir')).toBe('rtl');
+
+    // Back to the original: an answer from the cache, not a second request.
+    await act(async () => (host.querySelector('button[aria-label="Show the original lyrics"]') as HTMLElement).click());
+    expect(requests).toHaveLength(1);
+    expect(host.querySelector('button[aria-label="Translate the lyrics"]')).not.toBeNull();
+    await act(async () => root.unmount());
+  });
+
+  it('stacks the two languages when the layout asks for it, without asking again', async () => {
+    // Real text, not the echo: a translation that reads the same as the line is left out.
+    vi.stubGlobal('fetch', async (_url: string, init: RequestInit) => {
