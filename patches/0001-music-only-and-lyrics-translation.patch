--- /dev/null
+++ b/web/app/src/lyrics/translation.test.ts
@@ -0,0 +1,201 @@
+// @vitest-environment happy-dom
+import { describe, expect, it } from 'vitest';
+import { line, type LyricLine } from './model';
+import {
+  batchesOf,
+  cacheKey,
+  flattenLines,
+  forgetTranslations,
+  isRtl,
+  MAX_BATCH_CHARS,
+  normalizeLanguage,
+  parseGtxResponse,
+  payloadOf,
+  projectWords,
+  rebuildLines,
+  sameLanguage,
+  splitByMarkers,
+  translateLyrics,
+  type TextSlot,
+} from './translation';
+
+/** The shape `translate_a/single` answers with: segments in `[0]`, detected language in `[2]`. */
+const gtx = (body: string, source = 'en') => [[[body, 'translation', null, null, 10]], null, source, null, null, null, 0.9];
+
+const slot = (text: string, lineIndex = 0, background = false): TextSlot => ({ lineIndex, background, text, sectionHeader: false });
+
+function echoFetch(seen: string[]) {
+  return (async (_url: string, init?: RequestInit) => {
+    const payload = String((init?.body as URLSearchParams).get('q'));
+    seen.push(payload);
+    // An identity "translation": the endpoint hands the payload back with its markers intact.
+    return { ok: true, status: 200, json: async () => gtx(payload) };
+  }) as unknown as typeof fetch;
+}
+
+describe('translation batching (LyricsTranslation.kt)', () => {
+  it('keeps every batch within 3,500 characters and every slot in order', () => {
+    const slots = Array.from({ length: 40 }, (_, index) => slot('x'.repeat(200), index));
+    const batches = batchesOf(slots);
+    expect(batches.length).toBeGreaterThan(1);
+    for (const batch of batches) {
+      expect(batch.payload.length).toBeLessThanOrEqual(MAX_BATCH_CHARS);
+      expect(payloadOf(batch.slots)).toBe(batch.payload);
+    }
+    expect(batches.flatMap((batch) => batch.slots)).toEqual(slots);
+  });
+
+  it('moves a slot that would overflow onto the next batch, and starts with a 3,500-char one', () => {
+    const slots = [slot('a'.repeat(3_000)), slot('b'.repeat(400)), slot('c'.repeat(500))];
+    const batches = batchesOf(slots);
+    // 3000, then +8+400, then +8+500 would be 3516: the last slot goes on its own.
+    expect(batches.map((batch) => batch.slots.length)).toEqual([2, 1]);
+    expect(batches[0]!.payload.length).toBe(3_408);
+    expect(batches[1]!.payload).toBe('c'.repeat(500));
+  });
+
+  it('round-trips a payload through the private-use markers', () => {
+    const slots = [slot('first line'), slot('[Chorus]'.slice(1, -1), 1), slot('(ooh)', 1, true)];
+    expect(splitByMarkers(payloadOf(slots))).toEqual(['first line', 'Chorus', '(ooh)']);
+  });
+
+  it('leaves blank lines out and keeps section labels and background vocals as their own slots', () => {
+    const lines: LyricLine[] = [
+      line(0, ''),
+      line(1_000, 'Hello there'),
+      line(2_000, '[Verse 2]'),
+      line(3_000, 'Lead', { background: line(3_000, '(answer)') }),
+    ];
+    expect(flattenLines(lines)).toEqual([
+      { lineIndex: 1, background: false, text: 'Hello there', sectionHeader: false },
+      { lineIndex: 2, background: false, text: 'Verse 2', sectionHeader: true },
+      { lineIndex: 3, background: false, text: 'Lead', sectionHeader: false },
+      { lineIndex: 3, background: true, text: '(answer)', sectionHeader: false },
+    ]);
+  });
+});
+
+describe('translation response parsing', () => {
+  it('joins segments and reads the detected language', () => {
+    const body = `Hola\n\uE0000001\uE001\nmundo`;
+    const parsed = parseGtxResponse(gtx(body, 'en'), 2);
+    expect(parsed).toEqual({ texts: ['Hola', 'mundo'], source: 'en' });
+  });
+
+  it('joins a body split across several segments', () => {
+    const root = [[['Hola\n', 'Hola\n'], ['\uE0000001\uE001\nmundo', '\uE0000001\uE001\nmundo']], null, 'en'];
+    expect(parseGtxResponse(root, 2)).toEqual({ texts: ['Hola', 'mundo'], source: 'en' });
+  });
+
+  it('rejects a partial answer rather than mapping it onto the wrong lines', () => {
+    expect(parseGtxResponse(gtx('solo texto'), 2)).toBeNull();
+    expect(parseGtxResponse(gtx('a\n\uE0000001\uE001\n'), 2)).toBeNull();
+    expect(parseGtxResponse({ error: 'nope' }, 1)).toBeNull();
+    expect(parseGtxResponse([], 1)).toBeNull();
+  });
+});
+
+describe('language tags', () => {
+  it('normalizes base tags and the legacy aliases', () => {
+    expect(normalizeLanguage('en-US')).toBe('en');
+    expect(normalizeLanguage('iw_IL')).toBe('he');
+    expect(normalizeLanguage('in')).toBe('id');
+    expect(sameLanguage('he', 'iw')).toBe(true);
+    expect(sameLanguage('en', 'es')).toBe(false);
+  });
+
+  it('knows which destinations run right to left', () => {
+    expect(isRtl('fa')).toBe(true);
+    expect(isRtl('ar-EG')).toBe(true);
+    expect(isRtl('en')).toBe(false);
+  });
+});
+
+describe('timing reconstruction', () => {
+  const source: LyricLine = line(1_000, 'hold on tight', {
+    sungUntilMs: 5_000,
+    words: [
+      { startMs: 1_000, endMs: 3_000, text: 'hold', syllables: [] },
+      { startMs: 3_000, endMs: 3_400, text: 'on', syllables: [] },
+      { startMs: 3_400, endMs: 5_000, text: 'tight', syllables: [] },
+    ],
+  });
+
+  it('keeps every line in place, with its end and background placement', () => {
+    const lines: LyricLine[] = [line(0, ''), source, line(6_000, 'Lead', { background: line(6_100, '(ooh)') })];
+    const slots = flattenLines(lines);
+    const rebuilt = rebuildLines(
+      lines,
+      slots,
+      slots.map((s) => `t:${s.text}`),
+    );
+    expect(rebuilt.map((l) => l.timeMs)).toEqual([0, 1_000, 6_000]);
+    expect(rebuilt[0]!.text).toBe('');
+    expect(rebuilt[1]!.sungUntilMs).toBe(5_000);
+    expect(rebuilt[1]!.text).toBe('t:hold on tight');
+    expect(rebuilt[2]!.background?.text).toBe('t:(ooh)');
+    expect(rebuilt[2]!.background?.timeMs).toBe(6_100);
+  });
+
+  it('projects the source pace onto the translated words, within the line bounds', () => {
+    const words = projectWords(source, 'aguenta firme agora');
+    expect(words.map((w) => w.text)).toEqual(['aguenta', 'firme', 'agora']);
+    expect(words[0]!.startMs).toBe(1_000);
+    expect(words.at(-1)!.endMs).toBe(5_000);
+    // The long "hold" holds its translated share for longer than the short "on".
+    expect(words[0]!.endMs - words[0]!.startMs).toBeGreaterThan(words[1]!.endMs - words[1]!.startMs);
+    for (const [index, word] of words.entries()) {
+      expect(word.endMs).toBeGreaterThanOrEqual(word.startMs);
+      if (index > 0) expect(word.startMs).toBeGreaterThanOrEqual(words[index - 1]!.endMs);
+    }
+  });
+
+  it('re-brackets a translated section label', () => {
+    const lines = [line(0, '[Chorus]')];
+    expect(rebuildLines(lines, flattenLines(lines), ['Refrão'])[0]!.text).toBe('[Refrão]');
+  });
+});
+
+describe('translateLyrics', () => {
+  it('batches once, then answers from the cache without a request', async () => {
+    forgetTranslations();
+    const seen: string[] = [];
+    const lines = [line(0, 'one'), line(1_000, 'two')];
+    const first = await translateLyrics({ videoId: 'cache-song', lines, target: 'es', fetchImpl: echoFetch(seen) });
+    expect(first.kind).toBe('translated');
+    expect(seen).toHaveLength(1);
+    const second = await translateLyrics({ videoId: 'cache-song', lines, target: 'es', fetchImpl: echoFetch(seen) });
+    expect(second).toMatchObject({ kind: 'translated', fromCache: true });
+    expect(seen).toHaveLength(1);
+    // A different destination is a different entry.
+    expect(cacheKey('cache-song', 'es', flattenLines(lines))).not.toBe(cacheKey('cache-song', 'fa', flattenLines(lines)));
+  });
+
+  it('reports the source language when nothing needed translating', async () => {
+    forgetTranslations();
+    const lines = [line(0, 'hola')];
+    const result = await translateLyrics({ videoId: 'same-song', lines, target: 'en', fetchImpl: echoFetch([]) });
+    expect(result).toEqual({ kind: 'same', language: 'en' });
+  });
+
+  it('keeps the original when the request fails', async () => {
+    forgetTranslations();
+    const failing = (async () => ({ ok: false, status: 500, json: async () => null })) as unknown as typeof fetch;
+    const result = await translateLyrics({ videoId: 'fail-song', lines: [line(0, 'hola')], target: 'fa', fetchImpl: failing });
+    expect(result).toEqual({ kind: 'failed', reason: 'network' });
+  });
+
+  it('stops when the caller cancels', async () => {
+    forgetTranslations();
+    const controller = new AbortController();
+    controller.abort();
+    const result = await translateLyrics({
+      videoId: 'cancel-song',
+      lines: [line(0, 'hola')],
+      target: 'fa',
+      signal: controller.signal,
+      fetchImpl: echoFetch([]),
+    });
