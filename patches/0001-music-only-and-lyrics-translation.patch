+import type { YTNodes } from 'youtubei.js/web';
+
+/**
+ * A watch-queue row's cuts. YouTube Music carries the same recording twice —
+ * the catalogue song and its music video — and a wrapper row pairs the two,
+ * with either of them as its primary. Which one is which is the whole of what
+ * "Prefer song over music video" and the player menu's Convert item ask.
+ */
+
+/**
+ * A music video rather than the catalogue song: YouTube marks each watch
+ * endpoint with its type, ATV for the song and OMV/UGC for videos. (A radio
+ * seeded on a video id is all videos; one seeded on a song is mostly songs.)
+ */
+export function isMusicVideo(item: YTNodes.PlaylistPanelVideo): boolean {
+  const type = (item.endpoint?.payload as { watchEndpointMusicSupportedConfigs?: { watchEndpointMusicConfig?: { musicVideoType?: string } } } | undefined)
+    ?.watchEndpointMusicSupportedConfigs?.watchEndpointMusicConfig?.musicVideoType;
+  return type !== undefined ? type !== 'MUSIC_VIDEO_TYPE_ATV' : !item.album;
+}
+
+/** Every cut in row [raw], from whichever of the wrapper's slots they came. */
+export function rowCuts(raw: Record<string, unknown>): YTNodes.PlaylistPanelVideo[] {
+  const cuts = (raw.type === 'PlaylistPanelVideoWrapper'
+    ? [raw.primary, ...((raw.counterpart as unknown[] | undefined) ?? [])]
+    : [raw]) as (YTNodes.PlaylistPanelVideo | null | undefined)[];
+  return cuts.filter((c): c is YTNodes.PlaylistPanelVideo => c?.type === 'PlaylistPanelVideo');
+}
+
+/**
+ * [videoId]'s own cut among [cuts], and the other cut of the same track: its
+ * song when it's a video, its video when it's a song. Null when no cut is
+ * [videoId]; [other] is null when the row holds only the one.
+ */
+export function cutPair(
+  cuts: readonly YTNodes.PlaylistPanelVideo[],
+  videoId: string,
+): { self: YTNodes.PlaylistPanelVideo; other: YTNodes.PlaylistPanelVideo | null } | null {
+  const self = cuts.find((cut) => cut.video_id === videoId);
+  if (!self) return null;
+  const other = cuts.find((cut) => cut.video_id !== videoId && isMusicVideo(cut) !== isMusicVideo(self)) ?? null;
+  return { self, other };
+}
