+import { describe, expect, it } from 'vitest';
+import type { YTNodes } from 'youtubei.js/web';
+import { cutPair, isMusicVideo, rowCuts } from './cuts';
+
+// The up-next fixtures have no wrapper rows, so the pair is built here: the
+// shape YouTube Music's watch queue uses for the two cuts of one track.
+
+function cut(videoId: string, video: boolean, album?: string) {
+  return {
+    type: 'PlaylistPanelVideo',
+    video_id: videoId,
+    title: { toString: () => videoId },
+    album: album ? { name: album, id: 'MPREb_test' } : undefined,
+    endpoint: {
+      payload: {
+        watchEndpointMusicSupportedConfigs: {
+          watchEndpointMusicConfig: { musicVideoType: video ? 'MUSIC_VIDEO_TYPE_OMV' : 'MUSIC_VIDEO_TYPE_ATV' },
+        },
+      },
+    },
+  } as unknown as YTNodes.PlaylistPanelVideo;
+}
+
+const wrapper = (primary: YTNodes.PlaylistPanelVideo, counterpart: YTNodes.PlaylistPanelVideo) =>
+  ({ type: 'PlaylistPanelVideoWrapper', primary, counterpart: [counterpart] }) as Record<string, unknown>;
+
+describe('isMusicVideo', () => {
+  it('reads the watch endpoint: ATV is the song, OMV and UGC are videos', () => {
+    expect(isMusicVideo(cut('song', false))).toBe(false);
+    expect(isMusicVideo(cut('video', true))).toBe(true);
+  });
+
+  it('falls back on the album when the endpoint says nothing', () => {
+    const bare = { type: 'PlaylistPanelVideo', video_id: 'x', album: { name: 'Album', id: null } };
+    expect(isMusicVideo(bare as unknown as YTNodes.PlaylistPanelVideo)).toBe(false);
+    const noAlbum = { type: 'PlaylistPanelVideo', video_id: 'y' };
+    expect(isMusicVideo(noAlbum as unknown as YTNodes.PlaylistPanelVideo)).toBe(true);
+  });
+});
+
+describe('rowCuts', () => {
+  it('takes both slots of a wrapper and the one row of anything else', () => {
+    const song = cut('song', false, 'Album');
+    const video = cut('video', true);
+    expect(rowCuts(wrapper(song, video))).toEqual([song, video]);
+    expect(rowCuts({ type: 'PlaylistPanelVideo', video_id: 'solo' } as Record<string, unknown>)).toHaveLength(1);
+  });
+});
+
+describe('cutPair', () => {
+  const song = cut('song', false, 'Album');
+  const video = cut('video', true);
+
+  it('finds the other cut whichever slot it is in', () => {
+    const fromVideo = cutPair(rowCuts(wrapper(song, video)), 'video');
+    expect(fromVideo?.self).toBe(video);
+    expect(fromVideo?.other).toBe(song);
+    const fromSong = cutPair(rowCuts(wrapper(video, song)), 'song');
+    expect(fromSong?.self).toBe(song);
+    expect(fromSong?.other).toBe(video);
+  });
+
+  it('has no other cut when the row holds only the one', () => {
+    const pair = cutPair([song], 'song');
+    expect(pair?.self).toBe(song);
+    expect(pair?.other).toBeNull();
+  });
+
+  it("says nothing for a video id the row doesn't hold", () => {
+    expect(cutPair(rowCuts(wrapper(song, video)), 'someone-else')).toBeNull();
+  });
+});
